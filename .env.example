# Only needed for the PostgreSQL path (`npm run dev`). `npm run demo` needs no configuration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nawi_reportpro
JWT_SECRET=change-me-to-a-long-random-string
HMAC_SECRET=change-me-to-a-different-long-random-string
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# Base URL printed in certificate QR codes (the public verification page)
PUBLIC_VERIFY_URL=http://localhost:3000
